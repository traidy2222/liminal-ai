{
  "name": "liminal",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "tui": "npm run start --workspace=packages/tui",
    "web": "node scripts/run-web.mjs",
    "web:dev": "npm run dev --workspace=packages/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@liminal/core"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
