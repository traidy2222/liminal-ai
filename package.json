{
  "name": "liminal",
  "description": "Fair-source local AI coding agent harness by Vireon Dynamics — ReAct loop, 245+ tools, terminal + web + desktop, any OpenAI-compatible model.",
  "license": "FSL-1.1-MIT",
  "private": true,
  "homepage": "https://www.vireondynamics.com/liminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/traidy2222/liminal-ai.git"
  },
  "bugs": {
    "url": "https://github.com/traidy2222/liminal-ai/issues"
  },
  "bin": {
    "liminal": "./scripts/liminal.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @liminal/core && npm run build -w @liminal/protocol && npm run build -w @liminal/tools && npm run build -w @liminal/sidecar && npm run build -w @liminal/enterprise",
    "build:sidecar": "npm run build -w @liminal/core && npm run build -w @liminal/protocol && npm run build -w @liminal/tools && npm run build -w @liminal/sidecar",
    "sidecar": "npm run build:sidecar && npm run start -w @liminal/sidecar",
    "sidecar:dev": "npm run start -w @liminal/sidecar",
    "eval:sandbox": "npm run eval:sandbox -w packages/eval",
    "desktop:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-windows.ps1",
    "desktop:build:macos": "bash scripts/build-desktop.sh macos",
    "desktop:build:linux": "bash scripts/build-desktop.sh linux",
    "desktop:package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop-windows.ps1",
    "desktop:package:macos": "bash scripts/package-desktop.sh macos --copy-node-modules",
    "desktop:package:linux": "bash scripts/package-desktop.sh linux --copy-node-modules",
    "desktop:test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop-windows.ps1",
    "desktop:boot:smoke": "node scripts/test-desktop-boot.mjs",
    "setup": "node scripts/liminal.mjs setup",
    "doctor": "node scripts/liminal.mjs doctor",
    "tui": "node scripts/run-tui.mjs",
    "tui:bootstrap": "node scripts/run-tui.mjs --bootstrap",
    "web": "node scripts/run-web.mjs",
    "web:dev": "node scripts/run-web-dev.mjs",
    "web:dev:bootstrap": "node scripts/run-web-dev.mjs --bootstrap",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@liminal/core",
    "test:update-release": "node scripts/lib/update-release.test.mjs",
    "verify-harness-defaults-no-secrets": "node scripts/verify-harness-defaults-no-secrets.mjs",
    "verify:repo-secrets": "node scripts/verify-repo-secrets.mjs",
    "keys:generate": "node scripts/generate-license-keys.mjs",
    "docs:gen": "node scripts/gen-docs-env.mjs",
    "changelog:gen": "node scripts/gen-changelog.mjs",
    "changelog:import": "node scripts/changelog-import-from-docs.mjs",
    "benchmark:provider-strategies": "node scripts/benchmark-provider-strategies.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "browser:install": "npm exec --workspace=@liminal/tools -- playwright install chromium",
    "enterprise:pack": "node scripts/pack-enterprise-bundle.mjs",
    "audit:pro-ee": "node scripts/audit-pro-ee.mjs --production",
    "e2e:install-ee": "node scripts/e2e-install-ee-from-token.mjs",
    "marketing:capture": "node scripts/capture-marketing.mjs",
    "marketing:capture:advanced": "node scripts/capture-marketing.mjs --advanced",
    "marketing:capture:live": "node scripts/capture-marketing-live.mjs",
    "marketing:capture:desktop": "node scripts/capture-marketing-desktop.mjs",
    "marketing:video": "npm run studio -w @liminal/marketing-video",
    "marketing:video:render": "npm run render -w @liminal/marketing-video --",
    "marketing:video:render:all": "npm run render:all -w @liminal/marketing-video"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "discord.js": "^14.26.4",
    "vitepress": "^1.6.3"
  }
}
