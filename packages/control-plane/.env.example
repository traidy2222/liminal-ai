# Control plane (packages/control-plane) — copy to repo-root .env or packages/control-plane/.env
# Never commit real secrets. Stripe keys pasted in chat should be rotated in the Stripe dashboard.

PORT=3002

# Ed25519 license signing (private key ONLY here; public key ships in packages/core entitlements.ts)
CONTROL_PLANE_LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Supabase (service role for server-side writes; anon key optional for JWT verify path)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Dashboard (or npm run keys:generate after creating products)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Checkout redirects (website URLs)
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/dashboard?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/pricing

# CORS allowlist for browser clients (comma-separated origins; defaults to checkout URL origins)
# CONTROL_PLANE_CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Optional: default license term when Stripe period end is missing (days)
CONTROL_PLANE_LICENSE_TERM_DAYS=30
