{
  "name": "@liminal/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx/esm server/index.ts",
    "dev": "concurrently --kill-others-on-fail --names server,client \"npm run dev:server\" \"node scripts/wait-for-dev-api.mjs && npm run dev:client\"",
    "dev:server": "node --import tsx/esm --watch server/index.ts",
    "dev:client": "vite client/ --port 5173 --strictPort",
    "build:client": "vite build client/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@liminal/core": "*",
    "@liminal/tools": "*",
    "@types/react-syntax-highlighter": "^15.5.13",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
