    "test": "tsx --test \"src/**/*.test.ts\"",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@liminal/core": "*",
    "@mozilla/readability": "^0.5.0",
    "@types/aws4": "^1.11.6",
    "aws4": "^1.13.2",
    "docx": "^9.6.1",
    "jsdom": "^25.0.1",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
