AGENT_API_KEY=
AGENT_API_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=openrouter/owl-alpha
# Runtime self-management persists approved conversational changes in:
#   .agent_runtime_prefs.json (workspace root)
# You can pin env values, but explicit in-turn preference directives can override in session.
# Backward-compatible provider keys (used if AGENT_API_KEY is unset):
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
PORT=3001

# Typical quality bundle (copy into .env as needed — all optional)
# AGENT_SESSION_JSONL=1
# AGENT_TOOL_BODY_ELIDE=1
# AGENT_RECALL_EVERY_N=3
# AGENT_SPECULATIVE_READS=1
# AGENT_CRITIC_REQUIRE=1
# AGENT_EMBED_MODEL=openai/text-embedding-3-small
# AGENT_MEMORY_AUTO_EXTRACT=1
# Plus: AGENT_QUERY_REWRITE, AGENT_DISTILL, AGENT_CRITIC, AGENT_FAILURE_LOG, AGENT_FAST_MODEL — see below

# Optional: heuristic + tiny LLM (0/1) gate to skip user approval on clearly safe requiresApproval tools (TUI/web)
# AGENT_SAFETY_JUDGE=1
# AGENT_SAFETY_JUDGE_MODEL=...   # optional; defaults to the harness model (e.g. openrouter/owl-alpha)

# Optional: ms before auto-reject on pending tool approval (clamped 10s–600s; default 60s). Or set AgentConfig.approvalTimeoutMs.
# AGENT_APPROVAL_TIMEOUT_MS=120000

# Optional: destructive shell preflight — strict (default): prior think() only; balanced: same/prior plan() also counts.
# AGENT_DESTRUCTIVE_GATE=balanced

# Jarvis+ self-management (aggressive-but-safe starter defaults)
# AGENT_UI_VERBOSITY=normal
# AGENT_APPROVAL_TIMEOUT_MS=45000
# AGENT_DESTRUCTIVE_GATE=balanced
# AGENT_RATE_LIMIT_MAX_RETRIES=180
# AGENT_TRANSIENT_5XX_MAX_RETRIES=80
# AGENT_RETRY_MAX_DELAY_MS=300000
# AGENT_MIN_CONCURRENT_AGENTS=1               # adaptive throttle floor during provider rate-limit/reset storms
# AGENT_CONCURRENCY_COOLDOWN_MS=45000         # hold reduced spawn concurrency for this cooldown window
# AGENT_WEB_FETCH_RETRIES=6                   # retry budget for web_search/web_fetch/web_research network calls
# Notes:
# - Non-risky runtime preference changes can be auto-applied in-session and persisted.
# - Risky safety-reducing changes still require explicit "confirm".

# Optional: hide harness trace text + provider retry lines in web/TUI transcript (session JSONL unchanged). Values: quiet | normal
# AGENT_UI_VERBOSITY=quiet

# Optional: append HTTP GET status line to read_process_output when health_url is passed (see system prompt PROCESS_LIFECYCLE)
# AGENT_PROCESS_HEALTH=1

# Optional: TUI “MEMORY / SESSION NOTES” bullets (pipe-separated), shown above auto think snippets
# AGENT_TUI_MEMORY_BULLETS=Rate limit: 100 req/min|Auth uses JWT in cookies

# Optional: physical location injected into world context (helps agent answer location-aware questions)
# AGENT_LOCATION=Brisbane, Australia

# Long-horizon harness (world context + optional session JSONL)
# AGENT_SESSION_MODE=initializer   # first session scaffolding (see world context "Session mode")
# AGENT_SESSION_MODE=coding        # incremental follow-up sessions
# AGENT_SESSION_JSONL=1            # append events to .agent_sessions/<taskId>.jsonl

# Optional: replace huge tool result bodies outside the last N tool rounds with artifact pointers (saves context)
# AGENT_TOOL_BODY_ELIDE=1
# AGENT_TOOL_ELIDE_MIN_CHARS=10000
# AGENT_TOOL_ELIDE_KEEP_ROUNDS=3

# Optional: monorepo / project root for world context, .agent_notes.json, artifacts, and tool path defaults.
# TUI, web server, and eval CLI set this automatically from package layout; override if you run from an unusual cwd.
# AGENT_WORKSPACE_ROOT=C:\path\to\repo

# Optional: expose only a minimal tool set to the model until activate_tool_family loads a family (saves context).
# When unset or 0, all registered tools are visible (default).
# AGENT_TOOL_LAZY=1
# Optional: always-loaded profile when AGENT_TOOL_LAZY=1.
# balanced (default): core + remember/recall/memory_stats + vault_list/vault_links
# knowledge_first: full memory_advanced + full vault families always loaded
# max_autonomy: knowledge_first + repo_map + selected read-only code_intel helpers
# AGENT_ALWAYS_TOOLS_PROFILE=balanced

# Obsidian brain — absolute path to the SAME folder you open as a vault in Obsidian.
# Without this, vault_* tools write under ~/.agent_vault (not your Obsidian library).
# Plain Windows path or Obsidian-style file URL both work:
# AGENT_VAULT_PATH=C:\Users\traid\Documents\OBVAULTS\TheBrain\Trai\AI
# AGENT_VAULT_PATH=file:///C:/Users/traid/Documents/OBVAULTS/TheBrain/Trai/AI/

# Optional: OpenRouter-compatible embeddings model (hybrid recall + world-context priming)
# AGENT_EMBED_MODEL=openai/text-embedding-3-small

# Optional: MemReader-style auto-extract to remember() at end of a successful send (root harness)
# AGENT_MEMORY_AUTO_EXTRACT=1

# Optional: write one Episodes/*.md note per completed root send when AGENT_VAULT_PATH is set
# Explicit opt-in only: set AGENT_MEMORY_EPISODE=1
# AGENT_MEMORY_EPISODE=1

# Vault intelligence growth controls
# Default behavior when unset: AGENT_VAULT_AUTO_WRITE=off (explicit tool-based writes only)
# AGENT_VAULT_AUTO_WRITE=off        # default: disable auto wiki writes
# AGENT_VAULT_AUTO_WRITE=research   # auto-write on research-style runs
# AGENT_VAULT_AUTO_WRITE=aggressive # broader auto-write behavior
# AGENT_VAULT_DEDUPE=1              # default-on unless set to 0
# AGENT_VAULT_WRITE_BUDGET=8
# AGENT_VAULT_REQUIRE_LINKS=1
# AGENT_VAULT_OBSERVABILITY=1
# AGENT_VAULT_FIRST_STRICT=1        # optional hard block: require memory/vault priming before web_search

# Optional: tiny LLM pass to append 0–3 wikilinks on remember / vault_write
# AGENT_MEMORY_AUTOLINK=1
# AGENT_MEMORY_AUTOLINK_MODEL=openai/gpt-4o-mini

# Optional: merge-plan model for memory_consolidate (defaults to harness-style model slug)
# AGENT_MEMORY_CONSOLIDATE_MODEL=openrouter/owl-alpha

# Optional: every N ReAct rounds (root), inject hybrid recall_relevant snippet into context (0 = off)
# AGENT_RECALL_EVERY_N=3

# Memory debias + long-horizon retrieval controls (random old-memory influence reduction)
# AGENT_MEMORY_DEBIAS=1                      # default-on unless set to 0
# AGENT_MEMORY_MAX_AGE_DAYS_DEFAULT=540      # auto-recall age guard baseline
# AGENT_MEMORY_MIN_CONFIDENCE_DEFAULT=0.35   # auto-recall confidence floor (0-1)
# AGENT_MEMORY_INTROSPECTION_STRICT=1        # disable broad auto-recall on self-capability/status prompts

# Over-inference guard for user-opinion readback
# AGENT_OVERINFERENCE_GUARD=1                # default-on unless set to 0; prevents confident mind-reading
# AGENT_OVERINFERENCE_LLM_CHECK=1            # default-on unless set to 0; semantic same-model over-inference check

# Same-model intent inference (replaces regex-first routing)
# AGENT_INTENT_INFERENCE=1                   # default-on unless set to 0
# AGENT_INTENT_CONFIDENCE_MIN=0.65           # confidence threshold before applying LLM intent classification

# AAA document engine (progressive non-preset pipeline)
# AGENT_DOC_ENGINE=1                          # enable document tool family (doc_plan -> compose -> lint/repair -> render -> export -> QA)
# AGENT_DOC_AUTONOMY=1                        # autonomous deck pipeline defaults: infer beats, enforce provenance checks, bundle artifacts
# AGENT_DOC_WEB_ASSETS=1                      # permit web source/asset acquisition during document generation
# AGENT_DOC_QUALITY_MIN=90                    # optional fail-safe threshold; below this return diagnostics draft
# AGENT_DOC_REPAIR_BUDGET=3                   # optional max repair rounds per chunk
# AGENT_DOC_MAX_SOURCE_LOOKUPS=24             # cap autonomous source lookups for cost/latency control
# AGENT_DOC_STYLE_DIVERSITY_MIN=0.12          # minimum style-distance target across recent document runs

# Optional: after ≥3 rounds, run verify_result on assistant text that cites paths/code (extra latency)
# AGENT_CRITIC=1

# Optional: read_file follows up to 3 same-dir relative imports in one tool result (same send)
# AGENT_SPECULATIVE_READS=1

# Harness uplift — structured epistemic state is always on when working state is enabled (no flag).

# Optional: cheap model for JSON tasks (query rewrite, distill, auto-extract). Defaults to harness model.
# AGENT_FAST_MODEL=openai/gpt-4o-mini

# Optional: LLM query decomposition + HyDE for mid-turn recall_relevant (requires AGENT_FAST_MODEL or uses main model)
# AGENT_QUERY_REWRITE=1

# Optional: distill large read_file/web_fetch/shell/recall outputs + .agent_artifacts/ + read_artifact tool
# AGENT_DISTILL=1

# Optional: pass evidence excerpts into verify_result (critic) from this send's tool outputs
# AGENT_CRITIC_EVIDENCE=1

# Optional: recover if model emits pseudo XML-like tool tags instead of proper tool calls
# AGENT_PSEUDO_TOOL_RETRY_MAX=2

# Optional: keep retrying retryable provider errors (429/5xx/connection) until recovery.
# Useful for long research runs when you prefer waiting over failure.
# AGENT_RETRY_FOREVER=1
# AGENT_RETRY_WALL_TIME_MS=120000            # stop infinite retry storms; fail fast with explicit recoverable error
# AGENT_PROVIDER_CIRCUIT_FAILURES=4          # open provider circuit after N consecutive 429/5xx/reset failures
# AGENT_PROVIDER_CIRCUIT_COOLDOWN_MS=45000   # cooldown window while circuit is open

# Optional: auto-link graph edges on remember() + memory_graph + recall neighbor boost
# AGENT_MEMORY_GRAPH=1

# Optional: Mozilla Readability + jsdom for web_fetch main article text
# AGENT_WEB_READABILITY=1

# Optional: web_research tool (search + multi-fetch + synthesis JSON)
# AGENT_WEB_RESEARCH=1

# Vision sidecar ("eyes" model) — Owl remains primary reasoning model
# AGENT_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# AGENT_VISION_BASE_URL=https://openrouter.ai/api/v1
# AGENT_VISION_API_KEY=                      # optional; falls back to AGENT_API_KEY/provider key
# AGENT_VISION_TIMEOUT_MS=15000
# AGENT_VISION_MAX_IMAGE_BYTES=4194304
# AGENT_VISION_RETRIES=2
# AGENT_VISION_RETRY_BASE_MS=800

# Optional: append .agent_failures.jsonl on all-tool-fail / critic issues (failure_review tool)
# AGENT_FAILURE_LOG=1

# Optional: append JSON lines per eval scenario to .agent_eval_runs/runs.jsonl
# AGENT_EVAL_JSON_SINK=1

# Rebuild/verification runbook after core/tools edits:
# 1) npm run build -w packages/core
# 2) npm run build -w packages/tools
# 3) npm run typecheck
# 4) npm run test --workspace=@liminal/core
# 5) npm run eval --workspace=@liminal/eval -- --scenario intro-response-quality --scenario runtime-preference-risky-confirmation
