# Liminal — template for secrets + machine-only values
#
# Put here: API keys, PORT, paths that are specific to this computer.
# Put elsewhere: feature flags and tuning → Web Settings saves `.agent_runtime_prefs.json`;
#   product defaults → `packages/core/src/harness_default_constants.ts`.
# Precedence: real environment > `.agent_runtime_prefs.json` > typed defaults.

# --- Required (provider) ---
AGENT_API_KEY=

# --- Provider (typed default: OpenRouter + deepseek/deepseek-chat) ---
# deepseek/deepseek-chat  = DeepSeek V3 — cheapest production model (~$0.07/1M cached input)
# deepseek/deepseek-r1    = DeepSeek R1 — stronger reasoning, ~4× more expensive
# AGENT_API_BASE_URL=https://openrouter.ai/api/v1
# AGENT_MODEL=deepseek/deepseek-chat

# --- Direct DeepSeek API (skip OpenRouter markup, ~30% cheaper) ---
# AGENT_API_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-chat

# --- Heavier reasoning (still affordable) ---
# AGENT_API_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-reasoner

# --- Optional: re-enable sidecar model calls (each fires an extra completion) ---
# AGENT_RECALL_EVERY_N=3        # mid-turn recall every N rounds
# AGENT_QUERY_REWRITE=1         # multi-query expansion before recall
# AGENT_MEMORY_AUTO_EXTRACT=1   # end-of-turn memory extraction
# AGENT_SAFETY_JUDGE=1          # LLM approval pre-screening
# AGENT_SELF_HEAL_LINT=1        # lint self-repair rounds

# --- Local models (OpenAI-compatible `/v1/chat/completions`) ---
# The harness uses the official OpenAI SDK; point `AGENT_API_BASE_URL` at your server's `/v1` root.
# You still need a non-empty `AGENT_API_KEY` (many local stacks ignore it — use `ollama`, `lm-studio`, or `local`).
#
# LM Studio (default http://localhost:1234): load Qwen in LM Studio → enable Server → copy exact Model ID from UI.
# AGENT_API_KEY=lm-studio
# AGENT_API_BASE_URL=http://localhost:1234/v1
# AGENT_MODEL=qwen/qwen3.5-9b
# AGENT_FAST_MODEL=qwen/qwen3.5-9b
#
# Ollama OpenAI-compatible API (see https://ollama.com/library/qwen3.5:9b — model tag is usually `qwen3.5:9b`).
# AGENT_API_KEY=ollama
# AGENT_API_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=qwen3.5:9b
# AGENT_FAST_MODEL=qwen3.5:9b
#
# Optional while sanity-testing locals (some servers choke on `response_format: json_object` or tiny sidecar calls):
# AGENT_DISTILL=0
# AGENT_QUERY_REWRITE=0
# AGENT_CRITIC=0
# AGENT_SAFETY_JUDGE=0

# --- Browser stealth (bot-detection evasion, default: on) ---
# AGENT_BROWSER_STEALTH=0               # disable all addInitScript patches
# AGENT_BROWSER_USER_AGENT=             # override UA for browser context (default: Chrome 136 Win UA)
# AGENT_BROWSER_LOCALE=en-US            # navigator.language / Accept-Language in browser sessions
# AGENT_BROWSER_TIMEZONE=               # JS timezone injected via Playwright context — defaults to system
#                                        # timezone (Intl.DateTimeFormat), so JS time matches IP location.
#                                        # Override e.g. AGENT_BROWSER_TIMEZONE=Australia/Brisbane
# AGENT_BROWSER_CHROME_FULL_VERSION=    # full version in userAgentData brands (default: {major}.0.0.0)
# AGENT_BROWSER_WEBGL_VENDOR=           # UNMASKED_VENDOR_WEBGL spoof (default: "Google Inc. (Intel)")
# AGENT_BROWSER_WEBGL_RENDERER=         # UNMASKED_RENDERER_WEBGL spoof (default: Intel UHD 630 ANGLE)

# --- Deploy / machine layout (optional) ---
# PORT=3001
# AGENT_WORKSPACE_ROOT=
# AGENT_VAULT_PATH=

# --- Optional separate vision key (defaults to AGENT_API_KEY) ---
# AGENT_VISION_API_KEY=

# --- Operational / intelligence mode (suppress narrative drift for scheduled briefs) ---
# AGENT_PROTOCOL_INTENT_HINT=operational   # strips narrative output guidance; keeps epistemic rules
# AGENT_PROTOCOL_INTENT_HINT=coding        # strips markets/vault/research; keeps file/shell guidance
# AGENT_PROTOCOL_INTENT_HINT=knowledge     # full protocol (default)

# --- CAPTCHA solving (reCAPTCHA v2/v3, hCaptcha, Cloudflare Turnstile, image) ---
# Get a key from https://2captcha.com or https://capsolver.com
# AGENT_CAPTCHA_KEY=                    # API key (secret — never in prefs)
# AGENT_CAPTCHA_SERVICE=2captcha        # 2captcha | capsolver (default: 2captcha)
# AGENT_CAPTCHA_TIMEOUT_MS=120000       # max wait for human solver (default 2 min)
# AGENT_CAPTCHA_POLL_MS=3000            # polling interval (default 3 s)

# --- Phase 1 — Adaptive Intelligence (all off by default; enable individually) ---
# AGENT_INTENT_ROUTING=1            # route turns to fast model by intent class (needs AGENT_INTENT_INFERENCE=1)
# AGENT_INTENT_FAST_THRESHOLD=0.8   # min confidence to route introspection turns to fast model
# AGENT_INTENT_OPERATIONAL_MODEL=   # model for file-I/O-only turns (default: AGENT_FAST_MODEL)
# AGENT_CTX_HOT_ROUNDS=6            # verbatim rounds kept before compression
# AGENT_CTX_WARM_ROUNDS=12          # rounds kept as structured provenance blocks
# AGENT_CTX_PROVENANCE=1            # write .agent_artifacts/ provenance for re-expansion (default on)
# AGENT_DREAM_THRESHOLD=0.15        # min BM25 score to trigger auto-recall (0 = always recall)
# AGENT_DREAM_CONTRADICT_CONFIDENCE=0.85  # min confidence to auto-resolve a stale memory note
# AGENT_DREAM_CONTRADICT_AUTO_RESOLVE=1   # auto-update stale notes on contradiction (default on)
# AGENT_COMPENSATION_ENABLED=1      # undo plan side-effects on failure (default on)
# AGENT_COMPENSATION_MAX_ACTIONS=32 # max undo entries per plan

