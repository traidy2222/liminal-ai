OPENROUTER_API_KEY=sk-or-...
PORT=3001

# Optional: max wall-clock time (ms) for one user message / full ReAct run (default 600000 = 10 min)
# AGENT_SEND_TIMEOUT_MS=900000

# Optional: heuristic + tiny LLM (0/1) gate to skip user approval on clearly safe requiresApproval tools (TUI/web)
# AGENT_SAFETY_JUDGE=1
# AGENT_SAFETY_JUDGE_MODEL=...   # optional; defaults to the harness model (e.g. openrouter/owl-alpha)

# Optional: physical location injected into world context (helps agent answer location-aware questions)
# AGENT_LOCATION=Brisbane, Australia

# Optional: monorepo / project root for world context, .agent_notes.json, artifacts, and tool path defaults.
# TUI, web server, and eval CLI set this automatically from package layout; override if you run from an unusual cwd.
# AGENT_WORKSPACE_ROOT=C:\path\to\repo

# Obsidian brain — absolute path to the SAME folder you open as a vault in Obsidian.
# Without this, vault_* tools write under ~/.agent_vault (not your Obsidian library).
# Plain Windows path or Obsidian-style file URL both work:
# AGENT_VAULT_PATH=C:\Users\traid\Documents\OBVAULTS\TheBrain\Trai\AI
# AGENT_VAULT_PATH=file:///C:/Users/traid/Documents/OBVAULTS/TheBrain/Trai/AI/

# Optional: OpenRouter-compatible embeddings model (hybrid recall + world-context priming)
# AGENT_EMBED_MODEL=openai/text-embedding-3-small

# Optional: MemReader-style auto-extract to remember() at end of a successful send (root harness)
# AGENT_MEMORY_AUTO_EXTRACT=1

# Optional: write one Episodes/*.md note per completed root send when AGENT_VAULT_PATH is set (default on; set 0 to disable)
# AGENT_MEMORY_EPISODE=0

# Optional: tiny LLM pass to append 0–3 wikilinks on remember / vault_write
# AGENT_MEMORY_AUTOLINK=1
# AGENT_MEMORY_AUTOLINK_MODEL=openai/gpt-4o-mini

# Optional: merge-plan model for memory_consolidate (defaults to harness-style model slug)
# AGENT_MEMORY_CONSOLIDATE_MODEL=openrouter/owl-alpha

# Optional: every N ReAct rounds (root), inject hybrid recall_relevant snippet into context (0 = off)
# AGENT_RECALL_EVERY_N=3

# Optional: after ≥3 rounds, run verify_result on assistant text that cites paths/code (extra latency)
# AGENT_CRITIC=1

# Optional: read_file follows up to 3 same-dir relative imports in one tool result (same send)
# AGENT_SPECULATIVE_READS=1

# Harness uplift — structured epistemic state is always on when working state is enabled (no flag).

# Optional: cheap model for JSON tasks (query rewrite, distill, auto-extract). Defaults to harness model.
# AGENT_FAST_MODEL=openai/gpt-4o-mini

# Optional: LLM query decomposition + HyDE for mid-turn recall_relevant (requires AGENT_FAST_MODEL or uses main model)
# AGENT_QUERY_REWRITE=1

# Optional: distill large read_file/web_fetch/shell/recall outputs + .agent_artifacts/ + read_artifact tool
# AGENT_DISTILL=1

# Optional: pass evidence excerpts into verify_result (critic) from this send's tool outputs
# AGENT_CRITIC_EVIDENCE=1

# Optional: auto-link graph edges on remember() + memory_graph + recall neighbor boost
# AGENT_MEMORY_GRAPH=1

# Optional: Mozilla Readability + jsdom for web_fetch main article text
# AGENT_WEB_READABILITY=1

# Optional: web_research tool (search + multi-fetch + synthesis JSON)
# AGENT_WEB_RESEARCH=1

# Optional: append .agent_failures.jsonl on all-tool-fail / critic issues (failure_review tool)
# AGENT_FAILURE_LOG=1

# Optional: append JSON lines per eval scenario to .agent_eval_runs/runs.jsonl
# AGENT_EVAL_JSON_SINK=1
