# ═══════════════════════════════════════════════════════════════════════════════
# Liminal — harness configuration
# Fill in AGENT_API_KEY and pick your model. Everything else is pre-configured
# for the best out-of-the-box experience — just run and go.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────
AGENT_API_KEY=
AGENT_API_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=openrouter/owl-alpha

# Backward-compatible provider keys (used if AGENT_API_KEY is unset):
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# ── Model routing ─────────────────────────────────────────────────────────────
# Small/fast model for distill, query rewrite, auto-extract — set to a cheaper
# slug to cut cost. Defaults to AGENT_MODEL if unset.
AGENT_FAST_MODEL=openrouter/owl-alpha

# Vision sidecar — separate model for vision_analyze while the main model reasons.
# The free Nemotron vision model works great out of the box on OpenRouter.
AGENT_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AGENT_VISION_BASE_URL=https://openrouter.ai/api/v1
# AGENT_VISION_API_KEY=               # falls back to AGENT_API_KEY if unset
AGENT_VISION_TIMEOUT_MS=15000
AGENT_VISION_MAX_IMAGE_BYTES=4194304
AGENT_VISION_RETRIES=2
AGENT_VISION_RETRY_BASE_MS=800

# Embedding model — enables hybrid BM25+vector recall and "Relevant memory" priming.
# Free on OpenRouter; swap to openai/text-embedding-3-small for higher quality.
AGENT_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# ── Interface ─────────────────────────────────────────────────────────────────
PORT=3001
# AGENT_UI_VERBOSITY=quiet            # hide harness trace + provider retry lines
# AGENT_LOCATION=Brisbane, Australia  # injected into world context for location-aware tasks

# ── Context & session health ──────────────────────────────────────────────────
# Append-only event trace for debugging and long-horizon session handoff
AGENT_SESSION_JSONL=1
# AGENT_SESSION_GREET=0               # disable model opening greeting (web/TUI + after session reset)
# AGENT_PERSONA_BOOTSTRAP=0           # disable first-run model prompt asking how assistant should sound
# AGENT_PERSONA_BOOTSTRAP_ALLOW_SKIP=0 # require persona input; if 1, user can type "skip" or "/skip"
# Replace huge stale tool results with artifact pointers (pairs with DISTILL)
AGENT_TOOL_BODY_ELIDE=1
# Distill large read_file / web_fetch / shell outputs into .agent_artifacts/
AGENT_DISTILL=1
# Mid-turn recall_relevant priming every N ReAct rounds (0 = off)
AGENT_RECALL_EVERY_N=3
# read_file resolves up to 3 same-dir relative imports in one shot
AGENT_SPECULATIVE_READS=1
# LLM query decomposition + HyDE for better mid-turn recall
AGENT_QUERY_REWRITE=1

# ── Memory & vault ────────────────────────────────────────────────────────────
# Auto-remember() extractions at end of successful sends (one small completion per turn)
AGENT_MEMORY_AUTO_EXTRACT=1
# Link notes in a graph and enable the memory_graph tool + recall neighbor boost
AGENT_MEMORY_GRAPH=1

# Obsidian vault path — set to the folder you open as a vault in Obsidian.
# Without this, vault_* tools write under ~/.agent_vault instead.
# AGENT_VAULT_PATH=C:\Users\yourname\Documents\ObsidianVault

# Per-turn episode chunks written to vault (opt-in — requires AGENT_VAULT_PATH)
# AGENT_MEMORY_EPISODE=1

# Suggest wikilinks after remember() / vault_write() (small extra LLM call per write)
# AGENT_MEMORY_AUTOLINK=1

# ── Tool loading ──────────────────────────────────────────────────────────────
# Keep the OpenAI tool list lean until the model activates a family (saves context)
AGENT_TOOL_LAZY=1
# Always-loaded tool profile: balanced | knowledge_first | max_autonomy
AGENT_ALWAYS_TOOLS_PROFILE=balanced
# Profile guidance:
# - balanced: safest default; activate specialist families on demand
# - knowledge_first: memory/vault heavy baseline
# - max_autonomy: includes files_edit baseline for coding-heavy autonomous runs
# Troubleshooting "tool not loaded for this session":
# 1) call list_tool_families (optionally with task_hint)
# 2) call activate_tool_family for suggested family
# 3) retry the intended tool call
# File tools default behavior:
# - speed-first by default for single-file edits
# - use edit_preview + multi_file_apply/refactor_plan_apply for coordinated or risky bulk refactors

# ── Self-healing lint runtime ─────────────────────────────────────────────────
# Auto-run a bounded lint diagnose->fix->verify loop after successful file edits.
AGENT_SELF_HEAL_LINT=1
AGENT_SELF_HEAL_MAX_PASSES=4
# changed-first scope, then expand to related diagnostics; set 1 to allow "." fallback
AGENT_SELF_HEAL_REPO_WIDE=0
# Stop after two non-improving passes and escalate with blocker diagnostics
AGENT_SELF_HEAL_STOP_ON_NO_PROGRESS=1
# Lint mode used by self-heal loop: tsc | eslint | command
AGENT_SELF_HEAL_LINT_MODE=tsc
# Optional allowlist for run_lint mode=command (comma-separated executables)
# AGENT_LINT_ALLOWED_COMMANDS=ruff,go,cargo

# ── Safety & approvals ────────────────────────────────────────────────────────
# Heuristic + single-token LLM gate — skips human approval for clearly safe tool calls
AGENT_SAFETY_JUDGE=1
# balanced: plan() also satisfies the shell danger pre-flight (not only think())
AGENT_DESTRUCTIVE_GATE=balanced
# Auto-reject pending approvals after this many ms (clamped 10s–600s)
AGENT_APPROVAL_TIMEOUT_MS=120000

# ── Web & research ────────────────────────────────────────────────────────────
# Mozilla Readability extraction for web_fetch — much cleaner article text
AGENT_WEB_READABILITY=1
# web_research tool: multi-query search + parallel fetch + synthesis JSON
AGENT_WEB_RESEARCH=1
# Retry budget for web_search / web_fetch / web_research network calls
AGENT_WEB_FETCH_RETRIES=6
# Per-URL fetch wall time for web_fetch + web_research page loads (ms, default 20000, max 120000)
# AGENT_WEB_FETCH_TIMEOUT_MS=20000
# Enable browser/Playwright tools (browser_open, browser_act)
AGENT_BROWSER=1

# ── Document engine ───────────────────────────────────────────────────────────
# Full PPTX / DOCX / PDF generation pipeline (doc_plan → compose → lint/repair → render → QA)
AGENT_DOC_ENGINE=1
# Autonomous deck pipeline: infer structure, enforce provenance, bundle artifacts
AGENT_DOC_AUTONOMY=1
# Permit web image/asset acquisition during document generation
AGENT_DOC_WEB_ASSETS=1
# Minimum quality score before export (0–100). Below this, a diagnostics draft is returned.
AGENT_DOC_QUALITY_MIN=90
# Max lint-repair iterations per section
AGENT_DOC_REPAIR_BUDGET=4
# Cap autonomous web lookups during research phase (cost/latency control)
AGENT_DOC_MAX_SOURCE_LOOKUPS=24
# Minimum style variance across sections (avoids monotonous decks)
AGENT_DOC_STYLE_DIVERSITY_MIN=0.12

# ── Reliability & resilience ──────────────────────────────────────────────────
# Hard wall-clock cap for one full send() turn — kills hung completions cleanly
AGENT_SEND_TIMEOUT_MS=600000
# Per-chunk stream timeout — retries if provider stops sending chunks for this long
AGENT_STREAM_CHUNK_TIMEOUT_MS=60000
# Max mid-stream retry attempts before surfacing the error to the user
AGENT_STREAM_MAX_RETRIES=3
# Recover from model pseudo-XML tool tags (model quirk on some providers)
AGENT_PSEUDO_TOOL_RETRY_MAX=2
# Max wall-clock time for one full send() retry window
AGENT_RETRY_WALL_TIME_MS=90000
# Retry budget for 429 rate-limit responses
AGENT_RATE_LIMIT_MAX_RETRIES=8
# Retry budget for transient 5xx errors
AGENT_TRANSIENT_5XX_MAX_RETRIES=8
# Max exponential backoff between retries
AGENT_RETRY_MAX_DELAY_MS=30000
# Adaptive throttle: minimum concurrent agents during provider storms
AGENT_MIN_CONCURRENT_AGENTS=1
# Hold reduced spawn concurrency for this window after a rate-limit storm
AGENT_CONCURRENCY_COOLDOWN_MS=60000
# Open provider circuit after N consecutive failures
AGENT_PROVIDER_CIRCUIT_FAILURES=3
# How long to hold the open circuit before retrying the provider
AGENT_PROVIDER_CIRCUIT_COOLDOWN_MS=60000

# ── Failure tracking ──────────────────────────────────────────────────────────
# Append-only failure log (.agent_failures.jsonl) — enables the failure_review tool
AGENT_FAILURE_LOG=1

# ── Critic / verification ─────────────────────────────────────────────────────
# Critic disabled by default (adds latency per turn).
# Evidence collection stays on so it's ready the moment you flip AGENT_CRITIC=1.
AGENT_CRITIC=0
AGENT_CRITIC_EVIDENCE=1

# ── Developer / eval ──────────────────────────────────────────────────────────
# Append JSON lines per eval run to .agent_eval_runs/ (eval CLI only)
AGENT_EVAL_JSON_SINK=1

# ── Optional personalisation ──────────────────────────────────────────────────
# Monorepo root — auto-detected from package layout; only override for unusual cwd
# AGENT_WORKSPACE_ROOT=C:\path\to\repo

# TUI memory strip — pipe-separated notes shown above the input line
# AGENT_TUI_MEMORY_BULLETS=Rate limit: 100 req/min|Staging URL: https://staging.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Rebuild runbook — run after editing packages/core/src/*.ts or packages/tools/src/*.ts:
#   npm run build -w packages/core
#   npm run build -w packages/tools
#   npm run typecheck
#   npm run test --workspace=@liminal/core
# ─────────────────────────────────────────────────────────────────────────────
